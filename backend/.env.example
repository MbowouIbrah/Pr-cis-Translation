# ══════════════════════════════════════════════════════════════════════════════
#  Précis Translator — modèle de configuration
#
#  Copier ce fichier en `backend/.env` puis remplir les cases VIDES.
#
#  RÈGLE DE CE FICHIER : il ne contient AUCUNE valeur qui fonctionne. Il est
#  suivi par git, donc tout ce qu'on y écrit est lisible par quiconque accède au
#  dépôt. Une clé qui marche n'y a pas sa place — pas même « en attendant ».
#  (C'est arrivé : la FRONTEND_API_KEY réelle y a vécu, et se retrouve dans neuf
#  commits. Elle a été révoquée le 27/07/2026.)
#
#  Les variables laissées vides ci-dessous sont VOLONTAIREMENT vides.
#  `app/config.py` refuse de démarrer en production tant qu'elles le sont.
# ══════════════════════════════════════════════════════════════════════════════


# ── Mode d'exécution ─────────────────────────────────────────────────────────
# `production` arme le contrôle de configuration : aucun secret de gabarit ne
# peut alors démarrer. Le contrôle s'arme AUSSI, tout seul, dès qu'une origine
# publique est déclarée dans ALLOWED_ORIGINS — pour que l'oubli de cette
# variable-ci ne désarme pas la protection.
PRECIS_ENV=development


# ── Traduction — DeepSeek ────────────────────────────────────────────────────
# Clé du compte : https://platform.deepseek.com/  → sans elle, rien ne traduit.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Modèle utilisé pour TOUTE traduction PDF.
#
# ATTENTION : le moteur PDF v2 ne lit PAS le paramètre `quality` de la requête.
# `TranslatorAI` prend son modèle ICI. Cette variable est donc le SEUL réglage
# qui décide de la vitesse et du coût des traductions PDF. Y mettre un modèle de
# raisonnement ralentit et renchérit CHAQUE page, sans qu'aucune option de
# l'interface ne le laisse deviner.
#
# `deepseek-chat` était un alias de compatibilité, SUPPRIMÉ par DeepSeek le
# 24/07/2026 : ne plus l'utiliser, il ne résout plus.
DEEPSEEK_MODEL=deepseek-v4-flash

# Modèles des autres moteurs, choisis par le paramètre `quality` de la requête.
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_PRECISE=deepseek-v4-flash


# ── Accès du frontend ────────────────────────────────────────────────────────
# Secret partagé entre l'interface et l'API, envoyé dans l'en-tête `X-API-Key`.
# La MÊME valeur doit être posée dans `frontend/.env` sous le nom VITE_API_KEY.
#
# Elle voyage dans le bundle du navigateur : elle n'est donc PAS un secret au
# sens fort (un visiteur peut la lire avec F12). Elle sert à écarter les appels
# automatisés qui ne passent pas par le site, rien de plus. Raison de plus pour
# qu'elle ne soit pas, en plus, publiée dans le dépôt.
#   Générer : python -c "import secrets;print('precis_fk_'+secrets.token_urlsafe(36))"
FRONTEND_API_KEY=


# ── Base de données PostgreSQL ───────────────────────────────────────────────
# DATABASE_URL sert quand on lance l'application DIRECTEMENT sur la machine
# (développement) : elle vise alors un PostgreSQL installé en local.
# Format : postgresql+asyncpg://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/BASE
DATABASE_URL=

# Les trois valeurs ci-dessous ne servent QU'À Docker : elles créent la base du
# conteneur, et `docker-compose.yml` en DÉRIVE l'URL de connexion. C'est
# pourquoi elles ne sont pas recopiées dans DATABASE_URL — des identifiants
# écrits deux fois finissent par différer, et l'on cherche alors longtemps
# pourquoi le service ne joint plus une base qui fonctionne très bien.
#   Générer le mot de passe : python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_USER=precis
POSTGRES_PASSWORD=
POSTGRES_DB=precis


# ── Authentification ─────────────────────────────────────────────────────────
# JWT_SECRET signe les jetons de connexion. C'est LE secret critique du projet :
# qui le connaît se fabrique un jeton d'administrateur. 32 caractères minimum,
# aléatoires, jamais réutilisés d'un environnement à l'autre.
#   Générer : python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=30


# ── E-mail — SMTP (Gmail : mot de passe d'application) ───────────────────────
# 1. Activer la validation en 2 étapes sur le compte Google
# 2. https://myaccount.google.com/apppasswords  → type « Autre », nom « Precis »
# 3. Copier les 16 caractères (sans espaces) dans SMTP_PASSWORD
#
# EMAIL_ENABLED=false coupe tout envoi (utile en développement et dans les
# tests). En production, `true` sans SMTP_PASSWORD est refusé au démarrage :
# aucune vérification de compte ne partirait, et les inscriptions resteraient
# bloquées sans que rien ne l'explique.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# ── Connexion Google ─────────────────────────────────────────────────────────
# Identifiant client OAuth (console Google Cloud). La même valeur va dans
# `frontend/.env` sous le nom VITE_GOOGLE_CLIENT_ID. Laisser vide désactive
# simplement le bouton « Se connecter avec Google ».
GOOGLE_CLIENT_ID=


# ── Paiement — Campay (Mobile Money) ─────────────────────────────────────────
# Identifiants de l'application, depuis le tableau de bord Campay.
# CAMPAY_ENV=DEMO vise le bac à sable (aucun argent réel) ; PROD encaisse.
# CAMPAY_WEBHOOK_KEY vérifie la signature des avis de paiement : le webhook est
# une URL PUBLIQUE, et sans cette vérification n'importe qui pourrait déclarer
# un paiement réussi.
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_WEBHOOK_KEY=
CAMPAY_ENV=DEMO


# ── Adresses publiques ───────────────────────────────────────────────────────
# ALLOWED_ORIGINS : les sites autorisés à appeler l'API, séparés par des
# virgules. En développement, l'interface passe par le proxy Vite (même
# origine) et CORS n'intervient pas. Y déclarer un domaine public signale à
# l'application qu'elle est EN LIGNE, et arme le contrôle de configuration.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# FRONTEND_URL : racine des liens envoyés dans les e-mails (vérification de
# compte, mot de passe oublié) et du retour de connexion Google. Une valeur
# restée sur localhost produit des e-mails dont les liens ne mènent nulle part :
# aucune inscription n'aboutit. OBLIGATOIRE en ligne — le contrôle de
# configuration refuse de démarrer tant qu'elle pointe sur localhost.
FRONTEND_URL=http://localhost:3000


# ── Marque publique (filigrane de l'aperçu d'essai) ──────────────────────────
# Le filigrane de l'aperçu gratuit est une mini-publicité, cuite dans les
# pixels. Ces valeurs en composent le texte — au changement de domaine, rien à
# recompiler.
BRAND_NAME=PRÉCIS
BRAND_TAGLINE=Professional Translation
PUBLIC_SITE=precis-translator.com


# ── Ordonnanceur de traduction ───────────────────────────────────────────────
# Nombre de traductions menées EN PARALLÈLE. Au-delà, les demandes attendent
# dans une file de PRIORITÉ ordonnée par le plan (admin > pro > starter >
# gratuit) — c'est ce qui donne corps à la vitesse vendue sur la carte de tarifs.
# Le coût dominant étant le CPU de rendu, trop de workers sur une seule machine
# ralentit tout le monde. 2 = défaut prudent mono-serveur ; à monter avec les cœurs.
TRANSLATION_WORKERS=2


# ── Journal des erreurs ──────────────────────────────────────────────────────
# Au-delà de ERROR_LOG_ALERT_THRESHOLD erreurs non traitées, une alerte part par
# e-mail — une seule à la fois (COOLDOWN en secondes). ADMIN_ALERT_EMAIL n'est
# qu'un repli, utilisé tant qu'aucun compte n'a le plan `admin` en base.
ERROR_LOG_ALERT_THRESHOLD=50
ERROR_LOG_ALERT_COOLDOWN=3600
ADMIN_ALERT_EMAIL=


# ── Divers ───────────────────────────────────────────────────────────────────
# Pays servant au calcul du tarif quand AUCUN en-tête géographique n'est posé.
PRICING_DEFAULT_COUNTRY=

# Chemin de LibreOffice, si la détection automatique échoue (rendu des aperçus
# non-PDF). Laisser vide sur un serveur où `soffice` est dans le PATH.
SOFFICE_PATH=
