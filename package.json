{
  "name": "precis-translator",
  "version": "1.0.0",
  "description": "Precis Translator root project configuration",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "backend\\venv\\Scripts\\uvicorn --app-dir backend app:app --reload --port 8000",
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" --kill-others --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
